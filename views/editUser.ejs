<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Edit User</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body>
        <div class="container mt-5">
            <h1 class="mb-4">Edit User</h1>
            <% if (typeof error_message !== 'undefined' && error_message) { %>
                <div class="alert alert-danger" role="alert">
                    <%= error_message %>
                </div>
            <% } %>
            <form action="/editUser/<%= user.id %>" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="username" class="form-label">User Name:</label>
                    <input type="text" class="form-control" id="username" name="username" value="<%= user.username %>" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password:</label>
                    <input type="password" class="form-control" id="password" name="password" value="<%= user.password %>" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">User Level:</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="level" id="levelManager" value="M" <%= user.level === 'M' ? 'checked' : '' %> required>
                        <label class="form-check-label" for="levelManager">
                            Manager
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="level" id="levelUser" value="U" <%= user.level === 'U' ? 'checked' : '' %>>
                        <label class="form-check-label" for="levelUser">
                            User
                        </label>
                    </div>
                </div>
                <% if (user.profile_image) { %>
                    <div class="mb-3">
                        <label class="form-label">Current Picture:</label><br>
                        <img src="<%= user.profile_image %>" alt="Current profile picture" style="max-width:150px; height:auto;">
                    </div>
                <% } %>
                <div class="mb-3">
                    <label for="profileImage" class="form-label">Upload New Picture (optional):</label>
                    <input type="file" class="form-control" id="profileImage" name="profileImage" accept="image/*">
                </div>
                <input type="hidden" name="existingImage" value="<%= user.profile_image %>">
                <button type="submit" class="btn btn-primary">Update User</button>
                <a href="/users" class="btn btn-secondary">Back to Users</a>
            </form>
        </div>
    </body>
</html>
