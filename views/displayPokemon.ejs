<!-- Alex Hill -->
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Pokemon List</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
            body {
                background-color: #a8a8a8;
            }
            h1 {
                color: #1e3a8a;
                font-weight: bold;
                text-shadow: 0 0 10px rgba(30, 58, 138, 0.5);
            }
            .table thead th {
                background-color: #1e3a8a;
                color: white;
            }
            .table tbody tr:nth-child(odd) {
                background-color: #e3f2fd;
            }
            .table tbody tr:nth-child(even) {
                background-color: #ffffff;
            }
            .btn-primary {
                background-color: white;
                color: #1e3a8a;
                border: 1px solid #1e3a8a;
            }
            .btn-primary:hover {
                background-color: #f0f0f0;
                color: #1e3a8a;
            }
        </style>
    </head>
    <body>
        <div class="container mt-5">
            <h1 class="mb-4">Pokemon List</h1>

            <!-- Search Form -->
            <form method="POST" action="/searchPokemon" class="mb-4">
                <div class="row">
                    <div class="col-md-9"></div>
                    <div class="col-md-3">
                        <input type="text" name="pokemonName" class="form-control mb-2"
                               placeholder="Search by name..." required>
                        <button type="submit" class="btn btn-primary w-100 mb-2">Search</button>
                    </div>
                </div>
            </form>

            <% if (typeof error_message !== 'undefined' && error_message) { %>
                <div class="alert alert-danger" role="alert">
                    <%= error_message %>
                </div>
            <% } %>
            
            <% if (pokemon.length === 0) { %>
                <div class="alert alert-warning" role="alert">
                    No pokemon found in the database.
                </div>
            <% } else { %>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>id</th>
                            <th>description</th>
                            <th>base_total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (let iCount = 0; iCount < pokemon.length; iCount++) { %>
                            <tr>
                                <td><%= pokemon[iCount].id %></td>
                                <td><%= pokemon[iCount].description %></td>
                                <td><%= pokemon[iCount].base_total %></td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </body>
</html>   