<!-- Alex Hill -->
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Pokemon Search Result</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
            body {
                background-color: #a8a8a8;
            }
            h1 {
                color: #1e3a8a;
                font-weight: bold;
                text-shadow: 0 0 10px rgba(30, 58, 138, 0.5);
            }
            .result-card {
                background-color: white;
                border: 2px solid #1e3a8a;
                border-radius: 8px;
                padding: 30px;
                margin-top: 20px;
            }
            .result-label {
                color: #1e3a8a;
                font-weight: bold;
                font-size: 1.2em;
            }
            .result-value {
                font-size: 1.5em;
                margin-bottom: 15px;
            }
            .btn-primary {
                background-color: white;
                color: #1e3a8a;
                border: 1px solid #1e3a8a;
            }
            .btn-primary:hover {
                background-color: #f0f0f0;
                color: #1e3a8a;
            }
        </style>
    </head>
    <body>
        <div class="container mt-5">
            <h1 class="mb-4">Pokemon Search Result</h1>

            <% if (typeof error_message !== 'undefined' && error_message) { %>
                <div class="alert alert-danger" role="alert">
                    <%= error_message %>
                </div>
            <% } %>

            <% if (pokemon) { %>
                <div class="result-card text-center">
                    <div class="mb-4">
                        <img src="/public/images/<%= pokemon.id %>.png"
                             alt="<%= pokemon.description %>"
                             style="max-width: 200px; height: auto;"
                             onerror="this.src='/public/images/<%= pokemon.id %>.jpg'">
                    </div>
                    <div class="result-label">Pokemon Name:</div>
                    <div class="result-value"><%= pokemon.description %></div>

                    <div class="result-label">Base Total:</div>
                    <div class="result-value"><%= pokemon.base_total %></div>
                </div>
            <% } else if (!error_message) { %>
                <div class="alert alert-warning" role="alert">
                    No pokemon found with the name "<%= searchTerm %>". Please try again.
                </div>
            <% } %>

            <a href="/" class="btn btn-primary mt-4">Back to Pokemon List</a>
            <a href="/users" class="btn btn-secondary mt-4">View Users</a>
            <a href="/logout" class="btn btn-secondary mt-4">Logout</a>
        </div>
    </body>
</html>
