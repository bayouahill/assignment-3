<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Users List</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <script>
            function confirmDelete(username, userId) {
                if (confirm(`Are you sure you want to delete user "${username}"?`)) {
                    document.getElementById('deleteForm' + userId).submit();
                }
                return false;
            }
        </script>
    </head>
    <body>
        <div class="container mt-5">
            <h1 class="mb-4">Users List</h1>
            <% if (typeof error_message !== 'undefined' && error_message) { %>
                <div class="alert alert-danger" role="alert">
                    <%= error_message %>
                </div>
            <% } %>

            <!-- Only show Add User button if user is Manager -->
            <% if (userLevel === 'M') { %>
                <div class="mb-3">
                    <a href="/addUser" class="btn btn-success">Add User</a>
                </div>
            <% } %>

            <% if (users.length === 0) { %>
                <div class="alert alert-warning" role="alert">
                    No users found in the database.
                </div>
            <% } else { %>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Password</th>
                            <th>Level</th>
                            <th>Profile Picture</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (let iCount = 0; iCount < users.length; iCount++) { %>
                            <tr>
                                <td><%= users[iCount].username %></td>
                                <td><%= users[iCount].password %></td>
                                <td><%= users[iCount].level === 'M' ? 'Manager' : 'User' %></td>
                                <td>
                                    <% if (users[iCount].profile_image) { %>
                                        <img src="<%= users[iCount].profile_image %>" alt="Profile picture for <%= users[iCount].username %>" style="max-width: 100px; height: auto;">
                                    <% } else { %>
                                        <img src="/public/bayou_icon.jpg" alt="Default profile picture" style="max-width: 100px; height: auto;">
                                    <% } %>
                                </td>
                                <td>
                                    <a href="/editUser/<%= users[iCount].id %>" class="btn btn-primary btn-sm">Edit</a>
                                    <form id="deleteForm<%= users[iCount].id %>" action="/deleteUser/<%= users[iCount].id %>" method="post" style="display:inline;">
                                        <button type="button" onclick="confirmDelete('<%= users[iCount].username %>', <%= users[iCount].id %>)" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            <% } %>
            <a href="/" class="btn btn-primary mt-3">Back to Pokemon</a>
            <a href="/logout" class="btn btn-secondary mt-3">Logout</a>
        </div>
    </body>
</html>










